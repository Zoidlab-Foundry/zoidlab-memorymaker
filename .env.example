# --- ZoidLab MemoryMaker (Foundry Package 04) ---
BUILDER_SESSION_SECRET=change-me

# Backend
DATA_DIR=./backend/data
PORT=8500
ENABLE_MOCK_EMBEDDINGS=true
ENABLE_REAL_VECTOR_SEARCH=false
DEFAULT_VECTOR_BACKEND=mock
MEMORYMAKER_ADMINS=

# Frontend
MEMORYMAKER_API_URL=http://127.0.0.1:8500
NYQUEST_API=https://api.nyquest.ai
NYQUEST_APP_ORIGIN=https://app.nyquest.ai
SESSION_COOKIE_DOMAIN=.zoidlab.ai
PRO_TIERS=pro,teams
APP_DOMAIN=memorymaker.zoidlab.ai

# Local Docker Postgres (+pgvector) — the prototype defaults to SQLite; see README
DATABASE_URL=postgresql://zoidlab:zoidlab@localhost:5432/zoidlab_memorymaker
